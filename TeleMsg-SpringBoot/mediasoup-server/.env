# Mediasoup Server Configuration

# Server Port
PORT=3001

# RTC Configuration
RTC_MIN_PORT=40000
RTC_MAX_PORT=49999

# Announced IP (use your server's public IP in production)
ANNOUNCED_IP=127.0.0.1

# HTTPS (for production)
HTTPS_CERT_FULLCHAIN=
HTTPS_CERT_PRIVKEY=

# SpringBoot Backend URL
SPRINGBOOT_URL=http://localhost:8080

# Log Level (debug, warn, error)
LOG_LEVEL=debug

