# 开发环境配置示例
# 复制此文件为 .env 并根据你的实际情况修改

# 本地开发 (默认)
VITE_API_URL=http://localhost:8080/api
VITE_WS_URL=ws://localhost:8080/ws

# 如果你的服务器运行在其他地址，请修改为相应的 IP 和端口
# 例如：
# VITE_API_URL=http://192.168.1.100:8080/api  # 局域网服务器
# VITE_WS_URL=ws://192.168.1.100:8080/ws
#
# VITE_API_URL=http://your-server.com:8080/api  # 远程服务器
# VITE_WS_URL=ws://your-server.com:8080/ws
#
# VITE_API_URL=https://your-domain.com/api     # HTTPS 服务器
# VITE_WS_URL=wss://your-domain.com/ws

# 生产环境
# VITE_API_URL=https://api.yourdomain.com/api
# VITE_WS_URL=wss://api.yourdomain.com/ws
